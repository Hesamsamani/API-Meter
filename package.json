{
  "name": "api-meter",
  "version": "0.1.0",
  "description": "Windows system-tray command center for AI provider usage limits — Claude, Gemini, Grok, Cursor, Perplexity, and more.",
  "main": "main.js",
  "author": "Hesam Samani",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hesamsamani/API-Meter.git"
  },
  "homepage": "https://github.com/Hesamsamani/API-Meter#readme",
  "bugs": {
    "url": "https://github.com/Hesamsamani/API-Meter/issues"
  },
  "keywords": [
    "electron",
    "windows",
    "system-tray",
    "ai",
    "usage-monitor",
    "claude",
    "gemini",
    "grok",
    "cursor",
    "perplexity",
    "rate-limit",
    "quota"
  ],
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "test": "node --test tests/**/*.test.js",
    "icons:generate": "node scripts/generate-icons.js",
    "screenshots": "node scripts/capture-readme-screenshots.mjs",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "chart.js": "^4.5.1",
    "electron-store": "^8.1.0",
    "koffi": "^3.0.2"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^24.9.1",
    "playwright": "^1.60.0"
  },
  "build": {
    "appId": "com.apimeter.app",
    "productName": "API-Meter",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "**/*",
      "!tests/**",
      "!docs/**",
      "!scripts/**"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/koffi/**"
    ],
    "extraResources": [
      {
        "from": "assets/providers",
        "to": "assets/providers",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png"
    }
  }
}
