{
  "name": "api-meter",
  "version": "0.1.0",
  "description": "Multi-provider AI usage monitor",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "test": "node --test tests/**/*.test.js",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "engines": { "node": ">=18.0.0" },
  "dependencies": {
    "chart.js": "^4.5.1",
    "electron-store": "^8.1.0",
    "better-sqlite3": "^11.7.0"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.apimeter.app",
    "productName": "API-Meter",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": ["**/*", "!tests/**", "!docs/**", "!scripts/**"],
    "extraResources": [
      { "from": "assets/providers", "to": "assets/providers", "filter": ["**/*"] }
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "assets/icon.png"
    }
  }
}